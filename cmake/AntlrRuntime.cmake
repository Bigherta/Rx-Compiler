option(RX_USE_SYSTEM_ANTLR "Use the preinstalled ANTLR C++ runtime" OFF)

add_library(rx_antlr_runtime INTERFACE)

if(RX_USE_SYSTEM_ANTLR)
  find_path(RX_ANTLR_INCLUDE_DIR antlr4-runtime.h PATH_SUFFIXES antlr4-runtime)
  find_library(RX_ANTLR_LIBRARY NAMES antlr4-runtime)
  if(NOT RX_ANTLR_INCLUDE_DIR OR NOT RX_ANTLR_LIBRARY)
    message(FATAL_ERROR
      "System ANTLR C++ runtime headers/library not found. "
      "Install the ANTLR 4.13.x development package or specify "
      "RX_ANTLR_INCLUDE_DIR and RX_ANTLR_LIBRARY. "
      "For a local bundled build, set RX_USE_SYSTEM_ANTLR=OFF.")
  endif()

  find_package(Threads REQUIRED)
  try_run(RX_ANTLR_VERSION_EXIT RX_ANTLR_VERSION_COMPILED
    "${CMAKE_BINARY_DIR}/CMakeFiles/rx-antlr-version"
    "${CMAKE_CURRENT_LIST_DIR}/CheckAntlrRuntime.cpp"
    CMAKE_FLAGS "-DINCLUDE_DIRECTORIES:STRING=${RX_ANTLR_INCLUDE_DIR}"
    LINK_LIBRARIES "${RX_ANTLR_LIBRARY}" Threads::Threads
    CXX_STANDARD 23
    CXX_STANDARD_REQUIRED ON
    RUN_OUTPUT_VARIABLE RX_ANTLR_VERSION
    COMPILE_OUTPUT_VARIABLE RX_ANTLR_VERSION_BUILD_LOG
  )
  if(NOT RX_ANTLR_VERSION_COMPILED)
    message(FATAL_ERROR
      "Cannot compile/link against the system ANTLR C++ runtime:\n"
      "${RX_ANTLR_VERSION_BUILD_LOG}")
  endif()
  if(NOT "${RX_ANTLR_VERSION_EXIT}" STREQUAL "0")
    message(FATAL_ERROR
      "Cannot run the system ANTLR version check: ${RX_ANTLR_VERSION_EXIT}. "
      "Check that the runtime library can be loaded.")
  endif()
  string(STRIP "${RX_ANTLR_VERSION}" RX_ANTLR_VERSION)
  if(NOT RX_ANTLR_VERSION MATCHES "^4\\.13($|\\.)")
    message(FATAL_ERROR
      "System ANTLR runtime is ${RX_ANTLR_VERSION}, but the checked-in parser "
      "was generated by ANTLR 4.13.2 and requires a 4.13.x runtime. "
      "Use a compatible installed runtime, or regenerate the parser with "
      "a generator matching the installed runtime.")
  endif()

  target_include_directories(rx_antlr_runtime SYSTEM INTERFACE
    "${RX_ANTLR_INCLUDE_DIR}")
  target_link_libraries(rx_antlr_runtime INTERFACE
    "${RX_ANTLR_LIBRARY}" Threads::Threads)
  message(STATUS "Using system ANTLR ${RX_ANTLR_VERSION}: ${RX_ANTLR_LIBRARY}")
  message(STATUS "ANTLR headers: ${RX_ANTLR_INCLUDE_DIR}")
else()
  # Build offline from vendored sources; do not fetch optional runtime tests.
  set(ANTLR_BUILD_CPP_TESTS OFF CACHE BOOL "Build ANTLR C++ runtime tests")
  set(ANTLR_BUILD_SHARED OFF CACHE BOOL "Build shared ANTLR C++ runtime")
  set(ANTLR_BUILD_STATIC ON CACHE BOOL "Build static ANTLR C++ runtime")
  add_subdirectory(
    "${CMAKE_CURRENT_LIST_DIR}/../vendor/antlr4-cpp"
    "${CMAKE_BINARY_DIR}/vendor/antlr4-cpp"
  )
  target_link_libraries(rx_antlr_runtime INTERFACE antlr4_static)
endif()
