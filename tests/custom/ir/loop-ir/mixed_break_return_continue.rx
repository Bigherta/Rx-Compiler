fn bump(n: &mut i32) { *n += 1; }
fn combine(a: i32, b: i32) -> i32 { a * 100 + b }
fn consume(u: (), n: &mut i32) { *n += 100; }
fn mixed_break_return_continue(a: bool, b: bool) -> i32 { let mut n: i32 = 0; loop { n += 1; if a { break 11; } else if n < 2 { continue; } else if b { return 22; } else { break 33; } } }
fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(mixed_break_return_continue((get_i32() != 0), (get_i32() != 0)) as i32); remaining -= 1; }
}
