fn bump(n: &mut i32) { *n += 1; }
fn combine(a: i32, b: i32) -> i32 { a * 100 + b }
fn consume(u: (), n: &mut i32) { *n += 100; }
fn partial_break_in_value(flag: bool) -> i32 { loop { break if flag { break 11; } else { 22 }; } }
fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(partial_break_in_value((get_i32() != 0)) as i32); remaining -= 1; }
}
