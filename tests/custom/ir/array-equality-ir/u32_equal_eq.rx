fn subject(a: &[u32; 5], b: &[u32; 5]) -> i32 { (a == b) as i32 }
fn main() {
let mut left: [u32; 5] = [(0u32 as u32), (4294967295u32 as u32), (2147483648u32 as u32), (17u32 as u32), (1u32 as u32)];
let mut right: [u32; 5] = [(0u32 as u32), (4294967295u32 as u32), (2147483648u32 as u32), (17u32 as u32), (1u32 as u32)];
println_i32(subject(&left, &right));
}
