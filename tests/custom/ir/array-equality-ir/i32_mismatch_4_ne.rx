fn subject(a: &[i32; 5], b: &[i32; 5]) -> i32 { (a != b) as i32 }
fn main() {
let mut left: [i32; 5] = [(0 as i32), (-2147483648 as i32), (2147483647 as i32), (-17 as i32), (1 as i32)];
let mut right: [i32; 5] = [(0 as i32), (-2147483648 as i32), (2147483647 as i32), (-17 as i32), (23 as i32)];
println_i32(subject(&left, &right));
}
