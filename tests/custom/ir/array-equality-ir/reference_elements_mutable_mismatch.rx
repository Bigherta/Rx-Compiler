fn subject(a: &[&mut i32; 3], b: &[&mut i32; 3]) -> i32 { (a == b) as i32 }
fn main() {
let mut fixture_2: i32 = (3 as i32);
let mut fixture_4: i32 = (-5 as i32);
let mut fixture_6: i32 = (8 as i32);
let mut left: [&mut i32; 3] = [&mut fixture_2, &mut fixture_4, &mut fixture_6];
let mut fixture_9: i32 = (3 as i32);
let mut fixture_11: i32 = (-5 as i32);
let mut fixture_13: i32 = (9 as i32);
let mut right: [&mut i32; 3] = [&mut fixture_9, &mut fixture_11, &mut fixture_13];
println_i32(subject(&left, &right));
}
