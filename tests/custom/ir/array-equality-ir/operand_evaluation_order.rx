fn equality_make_left(log: &mut i32) -> [i32; 2] { *log = *log * 10 + 1; [3, 5] }
fn equality_make_right(log: &mut i32) -> [i32; 2] { *log = *log * 10 + 2; [3, 5] }
fn subject() -> i32 { let mut log: i32 = 0; let same = equality_make_left(&mut log) == equality_make_right(&mut log); log * 10 + same as i32 }
fn main() {
println_i32(subject());
}
