fn subject(a: &[[i32; 3]; 2], b: &[[i32; 3]; 2]) -> i32 { (a == b) as i32 }
fn main() {
let mut left: [[i32; 3]; 2] = [[(3 as i32), (-5 as i32), (8 as i32)], [(13 as i32), (-21 as i32), (34 as i32)]];
let mut right: [[i32; 3]; 2] = [[(3 as i32), (-5 as i32), (8 as i32)], [(13 as i32), (-21 as i32), (35 as i32)]];
println_i32(subject(&left, &right));
}
