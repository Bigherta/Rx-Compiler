#[derive(Copy, Clone)]
struct Cell { value: i32 }
struct Other { value: i32 }

impl Cell { fn read(&self) -> i32 { self.value } }
impl Other { fn read(&self) -> i32 { self.value * 10 } }

fn subject() -> i32 { let c: Cell = Cell { value: 7 }; let d: Other = Other { value: 9 }; c.read() + d.read() }
fn main() {

let value = subject();
println_i32(value as i32);
}
