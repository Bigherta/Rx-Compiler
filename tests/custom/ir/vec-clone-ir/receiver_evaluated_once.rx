fn vec_clone_receiver_once<'a>(v: &'a Vec<i32>, n: &mut i32) -> &'a Vec<i32> { *n += 1; v }

fn subject(v: &Vec<i32>, n: &mut i32) -> Vec<i32> { vec_clone_receiver_once(v, n).clone() }
fn main() {
let mut fixture_1 = Vec::<i32>::new();
fixture_1.push((3 as i32));
fixture_1.push((5 as i32));
fixture_1.push((8 as i32));
let mut original: Vec<i32> = fixture_1;
let mut counter: i32 = 0;
let mut cloned = subject(&original, &mut counter);
println_i32((cloned).len() as i32);
println_i32(((cloned)[0]) as i32);
(cloned)[0] = !((cloned)[0]);
println_i32(((cloned)[1]) as i32);
(cloned)[1] = !((cloned)[1]);
println_i32(((cloned)[2]) as i32);
(cloned)[2] = !((cloned)[2]);
println_i32((original).len() as i32);
println_i32(((original)[0]) as i32);
println_i32(((original)[1]) as i32);
println_i32(((original)[2]) as i32);
println_i32(counter);
}
