fn shadowing(flag: bool) -> i32 {
    let n: i32 = 7;
    let selected: i32 = if flag {
        let n: i32 = 11;
        n
    } else {
        let n: i32 = 13;
        n
    };
    n * 100 + selected
}

fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(shadowing((get_i32() != 0)) as i32); remaining -= 1; }
}
