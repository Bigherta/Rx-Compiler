fn nested_continue(outer: i32, inner: i32) -> i32 {
    let mut i: i32 = 0;
    let mut total: i32 = 0;
    while i < outer {
        i += 1;
        if i == 2 { continue; }
        let mut j: i32 = 0;
        while j < inner {
            j += 1;
            if j == 2 { continue; }
            total += i * 10 + j;
        }
    }
    total
}

fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(nested_continue((get_i32() as i32), (get_i32() as i32)) as i32); remaining -= 1; }
}
