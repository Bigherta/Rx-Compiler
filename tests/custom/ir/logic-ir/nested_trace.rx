fn record(trace: &mut i32, digit: i32, value: bool) -> bool {
    *trace = *trace * 10 + digit;
    value
}
fn nested_trace(a: bool, b: bool, c: bool) -> i32 { let mut trace: i32 = 0; let value = record(&mut trace, 1, a) && (record(&mut trace, 2, b) || record(&mut trace, 3, c)); trace * 10 + value as i32 }
fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(nested_trace((get_i32() != 0), (get_i32() != 0), (get_i32() != 0)) as i32); remaining -= 1; }
}
