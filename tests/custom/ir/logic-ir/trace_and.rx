fn record(trace: &mut i32, digit: i32, value: bool) -> bool {
    *trace = *trace * 10 + digit;
    value
}
fn trace_and(a: bool, b: bool) -> i32 { let mut trace: i32 = 0; let value = record(&mut trace, 1, a) && record(&mut trace, 2, b); trace * 10 + value as i32 }
fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(trace_and((get_i32() != 0), (get_i32() != 0)) as i32); remaining -= 1; }
}
