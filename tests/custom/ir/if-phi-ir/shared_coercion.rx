fn record(trace: &mut i32, digit: i32, value: bool) -> bool {
    *trace = *trace * 10 + digit;
    value
}
fn combine(a: i32, b: i32) -> i32 { a * 100 + b }
fn consume(u: (), n: &mut i32) { *n += 100; }
fn shared_coercion(a: bool) -> i32 { let mut x: i32 = 37; let y: i32 = 41; let p: &i32 = if a { &mut x } else { &y }; *p }
fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(shared_coercion((get_i32() != 0)) as i32); remaining -= 1; }
}
