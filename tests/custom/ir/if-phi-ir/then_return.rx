fn record(trace: &mut i32, digit: i32, value: bool) -> bool {
    *trace = *trace * 10 + digit;
    value
}
fn combine(a: i32, b: i32) -> i32 { a * 100 + b }
fn consume(u: (), n: &mut i32) { *n += 100; }
fn then_return(a: bool) -> i32 { if a { return 11; } else { 22 } }
fn main() {
    let mut remaining = get_i32();
    while remaining > 0 { println_i32(then_return((get_i32() != 0)) as i32); remaining -= 1; }
}
